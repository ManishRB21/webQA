# ─────────────────────────────────────────────────────────────
# webQA — optional configuration
#
# Everything here has a working default. Copy to `.env` only if
# you need to change something. No external services required.
# ─────────────────────────────────────────────────────────────

# ── AI analysis (optional) ───────────────────────────────────
# Without a key the audit runs fully and produces a complete report;
# it just uses generated prose instead of AI root-cause analysis.
# Only needed if you are NOT already signed in to Claude Code or `ant`.
# The engine auto-detects an existing Claude login first — run `webqa --auth`
# to see which credential it would use.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
AI_ENABLED=true
# Findings per enrichment request, and a cap on total requests so a
# noisy site cannot run up an unexpected bill.
AI_MAX_FINDINGS_PER_BATCH=12
AI_MAX_REQUESTS=8

# ── Output ───────────────────────────────────────────────────
WEBQA_OUTPUT_DIR=./webqa-results
WEBQA_VERBOSE=true

# ── Crawl + browser budgets ──────────────────────────────────
# Hard ceilings applied regardless of what the CLI requests.
MAX_PAGES_HARD_LIMIT=500
MAX_DEPTH_HARD_LIMIT=5
PAGE_NAVIGATION_TIMEOUT_MS=30000
PAGE_TOTAL_BUDGET_MS=90000
AUDIT_TOTAL_BUDGET_MS=1800000
MAX_INTERACTIONS_PER_PAGE=12
MAX_LINK_CHECKS=400
# Politeness delay between requests to the same origin.
CRAWL_DELAY_MS=250
USER_AGENT=Mozilla/5.0 (compatible; webQA-Auditor/0.1)

# ── SSRF protection ──────────────────────────────────────────
# Blocks private, loopback, link-local, and cloud-metadata ranges
# after DNS resolution. Only disable when auditing a host you own
# on your own network — this is what stops the browser being used
# to read internal services.
SSRF_PROTECTION=true
# Comma-separated hostnames exempt from the check. Use sparingly.
SSRF_ALLOWLIST=
